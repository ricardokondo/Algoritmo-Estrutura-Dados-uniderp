#include <stdio.h>

int main() {
    int num1;
    int num2;

    printf("Digite o numero 1);
    scanf("%d", &num1);
    
    printf("Digite o  numero 2);
    scanf("%d", &num2);

    if (num1 > num2) {
        printf("%d e maior que %d.\n", num1, num2);
    } 
    else if (num2 > num1) {
        printf("%d e maior que %d.\n", num2, num1);
    } 
    else {
        printf("Os numeros sao iguais.\n");
    }

    return 0;
}